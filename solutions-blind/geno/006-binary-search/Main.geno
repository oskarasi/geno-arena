/// Iterative binary search over a sorted ascending Int list.

func binary_search(xs: List[Int], target: Int) -> Int
    example [1, 3, 5, 7, 9], 5 -> 2
    example [1, 3, 5, 7, 9], 1 -> 0
    example [1, 3, 5, 7, 9], 9 -> 4
    example [1, 3, 5, 7, 9], 4 -> -1
    example [], 1 -> -1
    example [2], 2 -> 0
    var lo: Int = 0
    var hi: Int = length(xs) - 1
    while lo <= hi do
        let mid: Int = lo + (hi - lo) / 2
        if xs[mid] == target then
            return mid
        else if xs[mid] < target then
            lo = mid + 1
        else
            hi = mid - 1
        end if
    end while
    return -1
end func

@untested("entry point")
func main() -> String
    let xs: List[Int] = [1, 3, 5, 7, 9]
    return "5@" + to_string(binary_search(xs, 5)) + " 4@" + to_string(binary_search(xs, 4))
end func
