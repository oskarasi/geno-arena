/// Luhn checksum validation with space/hyphen normalization.

import String

func digit_at(s: String, i: Int) -> Int
    requires i >= 0 and i < length(s)
    example "79927398713", 0 -> 7
    example "79927398713", 10 -> 3
    match parse_int(String.char_at(s, i)) with
    | Some(d) -> return d
    | None -> return -1
    end match
end func

func is_all_digits(s: String) -> Bool
    example "123" -> true
    example "12a" -> false
    example "" -> false
    example "0" -> true
    if length(s) == 0 then
        return false
    end if
    var i: Int = 0
    while i < length(s) do
        let ch: String = String.char_at(s, i)
        if ch < "0" or ch > "9" then
            return false
        end if
        i = i + 1
    end while
    return true
end func

func normalize_digits(s: String) -> String
    example "7992-7398-713" -> "79927398713"
    example "4532 0151 1283 0366" -> "4532015112830366"
    example "123" -> "123"
    example "" -> ""
    var out: String = ""
    var i: Int = 0
    while i < length(s) do
        let ch: String = String.char_at(s, i)
        if ch != " " and ch != "-" then
            out = out + ch
        end if
        i = i + 1
    end while
    return out
end func

func luhn_valid(digits: String) -> Bool
    example "79927398713" -> true
    example "79927398714" -> false
    example "4532015112830366" -> true
    example "7992-7398-713" -> true
    example "" -> false
    example "12a" -> false
    example "0" -> true
    let s: String = normalize_digits(digits)
    if is_all_digits(s) == false then
        return false
    end if
    var sum: Int = 0
    var alt: Bool = false
    var i: Int = length(s) - 1
    while i >= 0 do
        var d: Int = digit_at(s, i)
        if alt then
            d = d * 2
            if d > 9 then
                d = d - 9
            end if
        end if
        sum = sum + d
        alt = alt == false
        i = i - 1
    end while
    return sum % 10 == 0
end func

@untested("entry point")
func main() -> String
    let ok: Bool = luhn_valid("79927398713")
    let bad: Bool = luhn_valid("79927398714")
    let card: Bool = luhn_valid("4532015112830366")
    let spaced: Bool = luhn_valid("7992-7398-713")
    return "ok=" + to_string(ok) + " bad=" + to_string(bad) + " card=" + to_string(card) + " spaced=" + to_string(spaced)
end func
