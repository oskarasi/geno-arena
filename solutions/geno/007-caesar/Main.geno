/// Caesar cipher: shift letters by N; preserve case; leave non-letters unchanged.

import String

func normalize_mod(n: Int) -> Int
    example 27 -> 1
    example -1 -> 25
    example 0 -> 0
    example 25 -> 25
    example 52 -> 0
    example -27 -> 25
    let m: Int = n % 26
    if m < 0 then
        return m + 26
    else
        return m
    end if
end func

func shift_char(ch: String, shift: Int) -> String
    example "a", 3 -> "d"
    example "z", 1 -> "a"
    example "A", 3 -> "D"
    example "X", 5 -> "C"
    example "!", 3 -> "!"
    example " ", 1 -> " "
    example "m", 0 -> "m"
    example "Z", 1 -> "A"

    let lower: String = "abcdefghijklmnopqrstuvwxyz"
    let upper: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

    let lo: Int = String.index_of(lower, ch)
    if lo >= 0 then
        let safe: Int = normalize_mod(lo + shift)
        return String.char_at(lower, safe)
    end if

    let up: Int = String.index_of(upper, ch)
    if up >= 0 then
        let safe2: Int = normalize_mod(up + shift)
        return String.char_at(upper, safe2)
    end if

    return ch
end func

func encrypt(text: String, shift: Int) -> String
    example "Hello, World!", 3 -> "Khoor, Zruog!"
    example "abc", 1 -> "bcd"
    example "XYZ", 3 -> "ABC"
    example "", 5 -> ""
    example "Geno", 7 -> "Nluv"
    example "abc", 0 -> "abc"
    example "abc", 26 -> "abc"
    example "abc", -1 -> "zab"

    var result: String = ""
    var i: Int = 0
    while i < length(text) do
        result = result + shift_char(String.char_at(text, i), shift)
        i = i + 1
    end while
    return result
end func

func decrypt(text: String, shift: Int) -> String
    example "Khoor, Zruog!", 3 -> "Hello, World!"
    example "bcd", 1 -> "abc"
    example "ABC", 3 -> "XYZ"
    example "", 5 -> ""
    example "Nluv", 7 -> "Geno"
    return encrypt(text, 0 - shift)
end func

/// Round-trip check with a non-negative shift (covers requires).
func roundtrip_ok(text: String, shift: Int) -> Bool
    requires shift >= 0
    example "Hello", 3 -> true
    example "", 0 -> true
    example "Zzz!", 25 -> true
    return decrypt(encrypt(text, shift), shift) == text
end func

func join_from(args: List[String], start: Int) -> String
    requires start >= 0
    example ["a", "b", "c"], 1 -> "b c"
    example ["only"], 0 -> "only"
    example ["a", "b"], 2 -> ""
    var parts: List[String] = []
    var i: Int = start
    while i < length(args) do
        parts = append(parts, args[i])
        i = i + 1
    end while
    return join(parts, " ")
end func

/// Argv-style: `encrypt <shift> <text...>` or `decrypt <shift> <text...>`.
func run(args: List[String]) -> Result[String, String]
    example ["encrypt", "3", "Hello"] -> Ok("Khoor")
    example ["decrypt", "3", "Khoor"] -> Ok("Hello")
    example ["encrypt", "7", "Hello,", "Geno!"] -> Ok("Olssv, Nluv!")
    example ["encrypt", "3"] -> Err("usage: encrypt|decrypt <shift> <text...>")
    example [] -> Err("usage: encrypt|decrypt <shift> <text...>")
    example ["encrypt", "x", "ab"] -> Err("shift must be an integer")
    example ["bogus", "1", "ab"] -> Err("usage: encrypt|decrypt <shift> <text...>")

    if length(args) < 3 then
        return Err("usage: encrypt|decrypt <shift> <text...>")
    end if

    let cmd: String = args[0]
    match parse_int(args[1]) with
    | None -> return Err("shift must be an integer")
    | Some(shift) ->
        let text: String = join_from(args: args, start: 2)
        if cmd == "encrypt" or cmd == "enc" then
            return Ok(encrypt(text, shift))
        end if
        if cmd == "decrypt" or cmd == "dec" then
            return Ok(decrypt(text, shift))
        end if
        return Err("usage: encrypt|decrypt <shift> <text...>")
    end match
end func

/// Capability-free default entry.
@untested("entry point")
func main() -> String
    let plain: String = "Hello, Geno!"
    let shift: Int = 7
    let cipher: String = encrypt(plain, shift)
    let back: String = decrypt(cipher, shift)
    return "plain=" + plain + " cipher=" + cipher + " back=" + back
end func

@untested("requires --unsafe --cap env,print")
func cli_main() -> Int
    let args: List[String] = cli_args()
    match run(args) with
    | Ok(out) ->
        print(out)
        return 0
    | Err(e) ->
        print(e)
        return 1
    end match
end func
