/// Roman numeral conversion core (integers 1..3999).

import String

func roman_value(ch: String) -> Int
    example "I" -> 1
    example "V" -> 5
    example "X" -> 10
    example "L" -> 50
    example "C" -> 100
    example "D" -> 500
    example "M" -> 1000
    example "Z" -> 0
    if ch == "I" then
        return 1
    else if ch == "V" then
        return 5
    else if ch == "X" then
        return 10
    else if ch == "L" then
        return 50
    else if ch == "C" then
        return 100
    else if ch == "D" then
        return 500
    else if ch == "M" then
        return 1000
    else
        return 0
    end if
end func

/// Convert an integer in 1..3999 to a Roman numeral string.
/// Out-of-range inputs return Err (no `requires`: examples cover Err paths).
func to_roman(n: Int) -> Result[String, String]
    example 1 -> Ok("I")
    example 4 -> Ok("IV")
    example 9 -> Ok("IX")
    example 40 -> Ok("XL")
    example 44 -> Ok("XLIV")
    example 58 -> Ok("LVIII")
    example 1994 -> Ok("MCMXCIV")
    example 3999 -> Ok("MMMCMXCIX")
    example 0 -> Err("n must be between 1 and 3999")
    example 4000 -> Err("n must be between 1 and 3999")
    example -5 -> Err("n must be between 1 and 3999")
    if n < 1 or n > 3999 then
        return Err("n must be between 1 and 3999")
    end if

    var remaining: Int = n
    var result: String = ""

    let values: List[Int] = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
    let symbols: List[String] = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
    var i: Int = 0

    while i < length(values) do
        while remaining >= values[i] do
            result = result + symbols[i]
            remaining = remaining - values[i]
        end while
        i = i + 1
    end while

    return Ok(result)
end func

/// Parse a Roman numeral (case-insensitive) into an integer in 1..3999.
func from_roman(s: String) -> Result[Int, String]
    example "I" -> Ok(1)
    example "IV" -> Ok(4)
    example "IX" -> Ok(9)
    example "XL" -> Ok(40)
    example "XLIV" -> Ok(44)
    example "lviii" -> Ok(58)
    example "MCMXCIV" -> Ok(1994)
    example "MMMCMXCIX" -> Ok(3999)
    example "" -> Err("empty roman numeral")
    example "ABC" -> Err("invalid roman numeral")

    if length(s) == 0 then
        return Err("empty roman numeral")
    end if

    let upper: String = to_upper(s)
    var total: Int = 0
    var i: Int = 0

    while i < length(upper) do
        let ch: String = String.char_at(upper, i)
        let val: Int = roman_value(ch)
        if val == 0 then
            return Err("invalid roman numeral")
        end if

        if i + 1 < length(upper) then
            let next_ch: String = String.char_at(upper, i + 1)
            let next_val: Int = roman_value(next_ch)
            if next_val > val then
                total = total + (next_val - val)
                i = i + 2
            else
                total = total + val
                i = i + 1
            end if
        else
            total = total + val
            i = i + 1
        end if
    end while

    if total < 1 or total > 3999 then
        return Err("invalid roman numeral")
    end if

    return Ok(total)
end func

/// Round-trip helper with a precondition on the numeric side.
func roman_roundtrip(n: Int) -> Bool
    requires n >= 1 and n <= 3999
    example 1 -> true
    example 44 -> true
    example 1994 -> true
    example 3999 -> true
    match to_roman(n) with
    | Err(_) -> return false
    | Ok(r) ->
        match from_roman(r) with
        | Ok(v) -> return v == n
        | Err(_) -> return false
        end match
    end match
end func
